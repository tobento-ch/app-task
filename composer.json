{
    "name": "tobento/app-task",
    "type": "library",
    "description": "App task manager.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "schedule",
        "task"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "tobento/app": "^1.0.7",
        "tobento/app-crud": "^1.0",
        "tobento/app-http": "^1.0",
        "tobento/app-migration": "^1.0",
        "tobento/app-language": "^1.0",
        "tobento/app-schedule": "^1.0",
        "tobento/app-translation": "^1.0",
        "tobento/app-user": "^1.0",
        "tobento/app-view": "^1.0",
        "tobento/service-repository": "^1.0",
        "tobento/service-repository-storage": "^1.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^4.0",
        "tobento/apps": "^1.0",
        "tobento/app-event": "^1.0",
        "tobento/app-testing": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Task\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Task\\Test\\": "tests",
            "Tobento\\Service\\Schedule\\Test\\": "vendor/tobento/service-schedule/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}